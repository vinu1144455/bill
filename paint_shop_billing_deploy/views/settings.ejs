<%- include('partials/header') %>
<div class="card" style="max-width:820px; margin:0 auto;">
  <h2>Shop & GST Profile Details</h2>
  <p style="color:var(--mut)">These details are printed on every government-compliant GST tax invoice generated by your store.</p>
  
  <form method="post" action="/settings">
    <div class="grid">
      <div>
        <label>Shop / Trade Name *</label>
        <input name="name" value="<%= shop.name %>" required>
      </div>
      <div>
        <label>Shop GSTIN (15-Digit GST No.)</label>
        <input name="gstin" value="<%= shop.gstin || '' %>" maxlength="15" style="text-transform:uppercase;" placeholder="e.g. 27AAPFU0939F1ZV">
      </div>
      <div>
        <label>Phone / Mobile</label>
        <input name="phone" value="<%= shop.phone || '' %>" placeholder="+91 9876543210">
      </div>
      <div>
        <label>Email Address</label>
        <input name="email" type="email" value="<%= shop.email || '' %>" placeholder="shop@example.com">
      </div>
      <div>
        <label>State & State Code *</label>
        <select name="state">
          <% (typeof states !== 'undefined' ? states : []).forEach(function(st) { %>
            <option value="<%= st %>" <%= (shop.state && shop.state.includes(st.slice(0,2))) ? 'selected' : '' %>><%= st %></option>
          <% }) %>
        </select>
      </div>
    </div>
    
    <div style="margin-top:14px;">
      <label>Full Shop Address</label>
      <input name="address" value="<%= shop.address || '' %>" placeholder="Shop No, Building, Street, Area, City, PIN">
    </div>

    <h3 style="margin:24px 0 10px; font-size:16px; border-bottom:1px solid var(--line); padding-bottom:6px;">Bank Details (Optional - Printed on Bill)</h3>
    <div class="grid">
      <div>
        <label>Bank Name</label>
        <input name="bankName" value="<%= shop.bankName || '' %>" placeholder="e.g. State Bank of India">
      </div>
      <div>
        <label>Account Number</label>
        <input name="bankAccount" value="<%= shop.bankAccount || '' %>" placeholder="e.g. 123456789012">
      </div>
      <div>
        <label>IFSC Code</label>
        <input name="bankIfsc" value="<%= shop.bankIfsc || '' %>" style="text-transform:uppercase;" placeholder="e.g. SBIN0001234">
      </div>
    </div>

    <h3 style="margin:24px 0 10px; font-size:16px; border-bottom:1px solid var(--line); padding-bottom:6px;">Invoice Terms & Conditions</h3>
    <div>
      <textarea name="terms" rows="3" style="width:100%; border-radius:10px; border:1px solid #c5cce0; padding:10px; font:inherit;"><%= shop.terms || '1. Goods once sold will not be taken back.\n2. Certified that all particulars given above are true and correct.' %></textarea>
    </div>

    <br>
    <button class="btn" style="padding:12px 24px;">Save Shop & GST Profile</button>
  </form>
</div>
<%- include('partials/footer') %>
